generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

// COMMERCE : vend des produits physiques, le stock est suivi.
// SERVICE  : prestations de service, pas de suivi de stock.
enum ShopType {
  COMMERCE
  SERVICE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Product {
  id        Int        @id @default(autoincrement())
  name      String
  price     Int // montant en francs CFA (devise sans sous-unité)
  stock     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saleItems SaleItem[]
}

model Sale {
  id        Int        @id @default(autoincrement())
  total     Int
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  userId    Int
  items     SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  unitPrice Int
}

// Configuration globale de la boutique (une seule ligne, gérée par l'admin).
model Settings {
  id               Int      @id @default(autoincrement())
  companyName      String   @default("Ma Boutique")
  companyLogo      String?  @db.Text // data URL base64
  companyAddress   String?
  companyPhone     String?
  receiptFooter    String?  @default("Merci de votre visite !")
  shopType         ShopType @default(COMMERCE)
  whatsappEnabled  Boolean  @default(false)
  whatsappTarget   String?
  whatsappSendTime String   @default("20:00")
  updatedAt        DateTime @updatedAt
}
